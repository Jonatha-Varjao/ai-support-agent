# ── JWT ──
# JWT secret (HS256). Generate: uv run python -c "import secrets; print(secrets.token_hex(32))"

# ── Database ──
DATABASE_URL=postgresql+asyncpg://aiagent:aiagent@localhost:5432/aiagent

# ── Auth ──
# JWT secret (HS256). Generate: uv run python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme
JWT_TTL_HOURS=24
ADMIN_EMAIL=admin@admin.com

# ── LLM provider ──
GEMINI_API_KEY=


# ── Embeddings ──
EMBEDDING_DIM=384

# ── MCP ──
MCP_URL=http://mcp:8000/mcp

COMPANY_WEBSITE_URL=https://www.example.com

# ── MLflow ──
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=ai-support-agent

# ── CORS ──
WEB_ORIGIN=http://localhost:5173
# ── RAG ──
RAG_TOP_K=5

# ── Cache ──
CACHE_SIM_THRESHOLD=0.85
CACHE_TTL_SECONDS=86400

# ── Handoff ──
HANDOFF_THRESHOLD=0.70

# ── RAG ──
RAG_TOP_K=5
RAG_UNANSWERED_THRESHOLD=0.35
VECTOR_WEIGHT=0.85
HISTORY_CHAR_BUDGET=3000
HISTORY_MSG_LIMIT=20


