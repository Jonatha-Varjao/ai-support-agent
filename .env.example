# ── General ──
ENV=dev
LOG_LEVEL=info

# ── Database ──
DATABASE_URL=postgresql+asyncpg://aiagent:aiagent@localhost:5432/aiagent

# ── Auth ──
# JWT secret (HS256). Generate: uv run python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme
JWT_TTL_HOURS=24
ADMIN_EMAIL=admin@admin.com

# ── LLM provider ──
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# OpenAI fallback (if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# ── Embeddings ──
EMBEDDING_DIM=384

# ── MCP ──
MCP_URL=http://mcp:8000/mcp
MCP_FETCH_TIMEOUT_SECONDS=20

# ── MLflow ──
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=ai-support-agent

# ── Rate limiting ──
RATE_LIMIT_IP_PER_MIN=30
RATE_LIMIT_USER_PER_MIN=20
RATE_LIMIT_LOGIN_PER_MIN=10

# ── CORS ──
WEB_ORIGIN=http://localhost:5173
MAX_BODY_BYTES=16384

# ── RAG ──
RAG_UNANSWERED_THRESHOLD=0.55
RAG_TOP_K=5

# ── Cache ──
CACHE_SIM_THRESHOLD=0.85
CACHE_TTL_SECONDS=86400

# ── Handoff ──
HANDOFF_THRESHOLD=0.70

# ── Dev fallback ──
AUTH_DEV_FALLBACK=true
ENABLE_LLM_TITLES=false
